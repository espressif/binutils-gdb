/* Xuantie matrix fields.  */
#define NMR 16
#define OP_MASK_MD              0x7
#define OP_SH_MD                15
#define OP_MASK_MS1             0x7
#define OP_SH_MS1               18
#define OP_MASK_MS2             0x7
#define OP_SH_MS2               21
#define OP_MASK_MS3             0x7
#define OP_SH_MS3               7
